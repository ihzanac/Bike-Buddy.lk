VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: prepend static demo catalog (bikes, accessories, services) in the UI
VITE_DEMO_DATA=false

# Optional: show sample users, listings, bookings, and stat floors on /admin* (not written to Firestore)
VITE_ADMIN_DUMMY_DATA=false

# Admin self-registration: must match the string in firestore.rules (adminProvisioningCode branch)
# After changing the key in rules, redeploy: npm run firebase:deploy:firestore-rules
# Requires .firebaserc "default" to be your real project id (firebase use --add)
# Default dev key (change in production):
VITE_FIREBASE_ADMIN_PROVISIONING_KEY=BIKEHUB_LOCAL_ADMIN_KEY_2024

# Optional: npm run seed:firestore — approved shop owner credentials (writes real Firestore docs)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Part images: only the image URL is stored in Firestore.
# Vite dev: default /api/upload/part-image → public/uploads/parts/
# PHP (public/api/upload-part-image.php): e.g.
# VITE_ENABLE_PART_FILE_UPLOAD=true
# VITE_PART_IMAGE_UPLOAD_PATH=/api/upload-part-image.php
# VITE_PART_IMAGE_UPLOAD_TOKEN=

# Bike images (local disk; Firestore only stores the URL in bikes.images)
# Vite dev: default POST /api/upload/bike-image → public/uploads/bikes/
# PHP: public/api/upload-bike-image.php
# VITE_ENABLE_BIKE_FILE_UPLOAD=true
# VITE_BIKE_IMAGE_UPLOAD_PATH=/api/upload-bike-image.php
# VITE_BIKE_IMAGE_UPLOAD_TOKEN=

# Customer forgot-password OTP over email (PHP + PHPMailer):
# Frontend endpoint path (or full URL) used by Forgot Password screens.
VITE_PASSWORD_OTP_API_PATH=/api/customer-password-otp.php
# Booking confirmation email endpoint fallback (when Cloud Function/Resend is unavailable).
VITE_BOOKING_RECEIPT_API_PATH=/api/customer-booking-receipt.php
#
# Server env (PHP runtime, NOT Vite):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURE=tls   # tls or ssl
# OTP_MAIL_FROM_EMAIL=
# OTP_MAIL_FROM_NAME=BikeBuddy
# OTP_RESET_TOKEN_SECRET=change-me
# CUSTOMER_OTP_CORS=1
# CORS_ALLOW_ORIGIN=*
# Also set Firebase Functions secret with the same token secret:
# firebase functions:secrets:set OTP_RESET_TOKEN_SECRET

# Gemini AI (bike compare assistant in customer bike page)
# VITE_GEMINI_API_KEY=
# Optional:
# VITE_GEMINI_MODEL=gemini-1.5-pro

# Customer home — Google Map embed (enable "Maps Embed API" for this key; restrict by HTTP referrer)
# VITE_GOOGLE_MAPS_API_KEY=
# Optional: VITE_MAP_EMBED_QUERY=Colombo, Sri Lanka
#
# Booking confirmation to Gmail (server — not a Vite env):
# 1) cd functions && npm install
# 2) firebase functions:secrets:set RESEND_API_KEY
# 3) From repo root: npm run firebase:deploy:functions
# The app calls sendBookingReceiptEmail (asia-south1) right after a booking is saved;
# it sends to the address in customerEmail via Resend. For any Gmail address, set a
# verified domain in Resend and BOOKING_EMAIL_FROM (no onboarding@ in production).
